# Lucid — environment configuration
# Copy this file to ".env" and fill in real values to enable live providers.
# Lucid runs fully WITHOUT any of these — they only upgrade the stubs.

# --- AI interpretation (optional) ---
# When set, Lucid will call a real LLM for dream interpretation instead of the
# built-in local interpreter. Leave blank to use the offline interpreter.
INTERPRETER_PROVIDER=
# e.g. anthropic | openai   (only read when INTERPRETER_PROVIDER is set)
INTERPRETER_API_KEY=
INTERPRETER_MODEL=

# --- Voice transcription (optional) ---
# When set, the mic button sends audio to a real speech-to-text provider.
# Leave blank and the UI falls back to "type what you said".
TRANSCRIBER_PROVIDER=
TRANSCRIBER_API_KEY=

# --- Server ---
PORT=4317
