{
  "name": "famtastic-site-studio",
  "version": "1.0.0",
  "private": true,
  "description": "Chat-driven website builder for the FAMtastic ecosystem",
  "main": "server.js",
  "scripts": {
    "start": "FAMTASTIC_USE_RUNTIME_VNEXT=1 node server.js",
    "dev": "FAMTASTIC_USE_RUNTIME_VNEXT=1 node server.js",
    "studio": "while true; do FAMTASTIC_USE_RUNTIME_VNEXT=1 node server.js; echo '[studio] server exited — restarting in 1s...'; sleep 1; done",
    "test": "vitest run",
    "test:operator-v1": "vitest run tests/operator-v1-release.test.js",
    "test:immutable-target": "vitest run tests/deploy-immutable-target.test.js",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.87.0",
    "@fal-ai/client": "^1.9.6",
    "@google/generative-ai": "^0.24.1",
    "@vonage/server-sdk": "^3.26.4",
    "better-sqlite3": "^12.8.0",
    "cheerio": "^1.2.0",
    "dotenv": "^17.4.2",
    "express": "^4.21.0",
    "js-yaml": "^4.1.0",
    "multer": "^2.1.1",
    "node-pty": "^1.2.0-beta.12",
    "nodemailer": "^8.0.3",
    "openai": "^4.104.0",
    "puppeteer": "^24.40.0",
    "twilio": "^5.13.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "playwright": "^1.62.1",
    "vitest": "^4.1.1"
  }
}
